DEBUG=false

APP_HOST=127.0.0.1
APP_PORT=8000

DATABASE_URL=sqlite+aiosqlite:///./app.db
#DATABASE_URL=postgresql+asyncpg://user:password@localhost/dbname

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

JWT_SECRET_KEY=secret
SECRETS_ENCRYPTION_KEY=secret=

# Seed data
SUPERADMIN_LOGIN=secret
SUPERADMIN_PASSWORD=secret
SUPERADMIN_EMAIL=secret@example.com
SUPERADMIN_FIRST_NAME=secret
SUPERADMIN_LAST_NAME=secret

# Email
EMAIL_SERVICE='dummy'

# Sender
MAIL_FROM_EMAIL='secret@example.com'
MAIL_FROM_NAME='secret'

# Mailtrap
MAILTRAP_USER='secret'
MAILTRAP_SMTP_PASSWORD='secret'

MAILTRAP_SMTP_HOST='sandbox.smtp.mailtrap.io'
MAILTRAP_SMTP_PORT=2525
MAILTRAP_USE_TLS=True

# Mailjet
MAILJET_API_KEY='secret'
MAILJET_SECRET_KEY='secret'

GOOGLE_CLIENT_ID=XXXXXXXXXXXX-secret.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=XXXXXX-XXXXXXXXXX_XX_XXXXXXXXXXXXXX
GOOGLE_REDIRECT_URI="http://${APP_HOST}:${APP_PORT}/api/v1/google/auth/callback"
#GOOGLE_TOKEN_ENCRYPTION_KEY=XXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX=